<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubah Durasi Sewa"
            android:textColor="@color/gray_900"
            android:textSize="18sp"
            style="@style/title_md_bold"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray_700"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_300"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnEditTypeHarian"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Harian"
            android:backgroundTint="@color/olive_500"
            android:textColor="@color/white"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnEditTypeMingguan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Mingguan"
            android:backgroundTint="@color/white"
            android:textColor="@color/gray_700"
            android:layout_marginHorizontal="8dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnEditTypeBulanan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Bulanan"
            android:backgroundTint="@color/white"
            android:textColor="@color/gray_700"
            android:textAllCaps="false"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="150dp"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal"
        android:padding="2dp"
        android:background="@drawable/item_cart_quantity"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditMinDuration"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="-"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:background="@drawable/circle_background"
            app:backgroundTint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <TextView
            android:id="@+id/tvEditDurationValue"
            style="@style/label_lg_bold"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:text="1"
            android:textAlignment="center"
            android:textColor="@color/olive_500"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditAddDuration"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textSize="20sp"
            android:background="@drawable/circle_background"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:backgroundTint="@color/olive_500"
            android:textColor="@color/white"
            android:padding="0dp"/>
    </RelativeLayout>

    <Button
        android:id="@+id/btnSaveDuration"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Simpan Perubahan"
        android:background="@drawable/rounded_success_button"
        android:textColor="@color/white"
        android:textAllCaps="false"
        style="@style/label_lg_bold"/>

</LinearLayout>