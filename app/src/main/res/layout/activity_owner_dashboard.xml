<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.seller.OwnerDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gray_25">

        <include layout="@layout/view_toolbar"
            android:id="@+id/myToolbar"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <!--Layout Florist Name-->
                    <ImageView
                        android:id="@+id/imgShopProfile"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/circle_background"
                        android:src="@drawable/building" />

                    <LinearLayout
                        android:id="@+id/layoutFloristName"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/imgShopProfile"
                        android:layout_centerVertical="true">
                        <TextView
                            android:id="@+id/tvShopName"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:text="@string/florist_surabaya"
                            style="@style/title_md_bold"
                            android:textColor="@color/gray_900"
                            android:layout_weight="2"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvShopCity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kota Gresik"
                                android:textSize="14sp"
                                style="@style/body_md_regular"
                                android:textColor="@color/text_secondary"
                                android:layout_weight="2"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!--            Kunjungi Toko-->
                    <LinearLayout
                        android:id="@+id/btnVisitShop"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/rounded_normal_button"
                        android:clickable="false"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">
                        <TextView
                            style="@style/label_md_bold"
                            android:textColor="@color/text_accent"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:background="#0000"
                            android:text="Kunjungi Toko"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="8dp"/>
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">
                    <!--            PERSEWAAN SAYA-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/riwayat_pesanan"
                        style="@style/title_md_bold"
                        android:textColor="@color/gray_900"
                        android:layout_weight="2"/>

                    <!--            LIHAT SEMUA-->
                    <LinearLayout
                        android:id="@+id/tvHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lihat_semua"
                            style="@style/label_lg_regular"
                            android:textColor="@color/olive_900"/>
                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginHorizontal="5dp"
                            android:src="@drawable/right_arrow"
                            android:layout_gravity="center_vertical"/>

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/rounded_gray_layout"
                    android:elevation="2dp">

                    <LinearLayout
                        android:id="@+id/menuUnpaid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="36dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/imgUnpaid"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="4dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/belum_dibayar" />

                            <TextView
                                android:id="@+id/badgeUnpaid"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/text_error"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:text="0"
                                android:visibility="gone"/>
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Menunggu Konfirmasi"
                            style="@style/body_sm_regular"
                            android:textColor="@color/text_primary"
                            android:textAlignment="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menuProcessing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="36dp"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/dalam_proses"
                                android:layout_margin="4dp"/>
                            <TextView
                                android:id="@+id/badgeProcessing"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/text_error"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:text="99+"
                                android:visibility="gone"/>
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dalam\nProses"
                            style="@style/body_sm_regular"
                            android:textColor="@color/text_primary"
                            android:textAlignment="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menuShipped"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="40dp"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/dikirim"
                                android:layout_margin="4dp"/>
                            <TextView
                                android:id="@+id/badgeShipped"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/text_error"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:text="9"
                                android:visibility="gone"/>
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dikirim"
                            style="@style/body_sm_regular"
                            android:textColor="@color/text_primary"
                            android:textAlignment="center"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- JADWAL PERAWATAN SECTION -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvMaintenanceShcedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:clickable="true">

                    <RelativeLayout
                        android:id="@+id/layoutMaintenanceAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:background="@drawable/rounded_gray_layout">
                        <ImageView
                            android:id="@+id/ic_maintenance_dash"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/dalam_perawatan"
                            app:tint="@color/main_color"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ic_maintenance_dash"
                            android:layout_toStartOf="@id/btnMyMaintenance"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jadwal Perawatan Tanaman"
                                android:textColor="@color/black"
                                style="@style/title_md_bold"/>

                            <TextView
                                android:id="@+id/tvMaintenanceAlert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ada 8 tanaman menunggu perawatan"
                                android:textColor="#D32F2F"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnMyMaintenance"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="20dp"
                            android:src="@drawable/right_arrow"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:backgroundTint="@color/text_secondary"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvComplaintAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="visible"
                    android:clickable="true"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/text_error"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFF0F0">

                    <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ic_complaint_dash"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/text_error"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ic_complaint_dash"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvComplaintTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pusat Resolusi Komplain"
                            android:textColor="@color/text_error"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvComplaintCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Terdapat 2 komplain menunggu tanggapan"
                            android:textColor="@color/text_error"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="25dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_gray_layout"
                    android:elevation="2dp">

                    <RelativeLayout
                        android:id="@+id/layoutTotalProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/daftarProduk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daftar Produk"
                            android:layout_marginBottom="4dp"
                            style="@style/label_lg_bold"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/tvTotalProducts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/label_lg_regular"
                            android:layout_below="@id/daftarProduk"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/produk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="Produk"
                            style="@style/label_lg_regular"
                            android:layout_below="@id/daftarProduk"
                            android:layout_toRightOf="@id/tvTotalProducts"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                        <ImageView
                            android:id="@+id/btnMyProduct"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="20dp"
                            android:src="@drawable/right_arrow"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="center_vertical"
                            android:backgroundTint="@color/text_secondary"/>
                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/line"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="20dp"
                        android:src="@drawable/line"
                        android:backgroundTint="@color/gray_100"
                        android:layout_below="@id/layoutTotalProducts"/>
                    <LinearLayout
                        android:id="@+id/btnAddProduct"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/line"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_normal_button"
                        android:orientation="horizontal"
                        android:clickable="true">
                        <ImageView
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:clickable="false"
                            android:background="#0000"
                            android:src="@drawable/icon_add"/>
                        <TextView
                            style="@style/label_md_bold"
                            android:textColor="@color/text_accent"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:textAllCaps="false"
                            android:background="#0000"
                            android:text="Tambah Produk" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <include
                android:id="@+id/toolbar"
                layout="@layout/view_akun_dan_keamanan" />
        </LinearLayout>



    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="10dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/olive_500" />
    </FrameLayout>
</RelativeLayout>
