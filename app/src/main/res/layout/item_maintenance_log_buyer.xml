<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/imgDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="16dp"
        android:layout_alignParentStart="true"
        android:src="@drawable/circle_background"
        app:tint="@color/olive_500" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgDot"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#F1F5F9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLogDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18 Agustus 2024"
                    android:layout_centerVertical="true"
                    style="@style/body_lg_bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatSeller"
                    style="@style/body_md_bold"
                    android:backgroundTint="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Hubungi Penjual"
                    android:textColor="@color/olive_500"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_chat"
                    app:iconSize="18dp"
                    app:iconTint="@color/olive_500" />


            </RelativeLayout>

            <ImageView
                android:id="@+id/imgLogPhoto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/rounded_gray_layout" />

            <TextView
                android:id="@+id/tvLogDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tanaman sudah disiram dan diberi vitamin daun."
                style="@style/body_md_regular" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/viewLineTop"
        android:layout_width="2dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_above="@id/imgDot"
        android:layout_alignStart="@id/imgDot"
        android:layout_marginStart="5dp"
        android:background="#E2E8F0" />

    <View
        android:id="@+id/viewLineBottom"
        android:layout_width="2dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgDot"
        android:layout_alignBottom="@id/cvContent"
        android:layout_alignStart="@id/imgDot"
        android:layout_marginStart="5dp"
        android:background="#E2E8F0" />

</RelativeLayout>