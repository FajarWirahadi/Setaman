<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_gray_layout">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ajukan Komplain Perawatan"
        style="@style/title_md_bold"
        android:textColor="@color/text_error"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alasan Komplain *"
        style="@style/title_sm_bold"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerReason"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/rounded_gray_layout"
        style="@style/body_md_regular"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foto Bukti Kerusakan *"
        style="@style/title_sm_bold"
        android:layout_marginBottom="4dp"/>

    <ImageView
        android:id="@+id/imgComplaintPreview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/rounded_gray_layout"
        android:src="@drawable/ic_camera_add"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Penjelasan Detail *"
        style="@style/title_sm_bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etComplaintDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:hint="Jelaskan kondisi tanaman saat ini..."
        android:padding="12dp"
        style="@style/body_md_regular"
        android:background="@drawable/rounded_gray_layout"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitComplaint"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Kirim Komplain"
        style="@style/title_md_bold"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:enabled="false"
        app:cornerRadius="8dp"
        android:backgroundTint="@color/bg_error"/>

</LinearLayout>