<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Alamat Baru"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        style="@style/title_md_bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/label_lg_bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Label alamat"
                android:textColor="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/label_md_bold"
                android:text="@string/mandatory"
                android:textColor="@color/text_error"
                android:textSize="12sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etLabel"
            style="@style/body_lg_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:autofillHints="name"
            android:background="@drawable/rounded_normal_edittext"
            android:gravity="top|start"
            android:hint="Rumah, Kantor, Apartment"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/label_lg_bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/nama_penerima"
                android:textColor="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/label_md_bold"
                android:text="@string/mandatory"
                android:textColor="@color/text_error"
                android:textSize="12sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etReceiverName"
            style="@style/body_lg_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="name"
            android:background="@drawable/rounded_normal_edittext"
            android:gravity="top|start"
            android:hint="Fajar Wirahadi Kusuma"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/label_lg_bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/nomor_hp"
                android:textColor="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/label_md_bold"
                android:text="@string/mandatory"
                android:textColor="@color/text_error"
                android:textSize="12sp"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_normal_edittext"
                android:hint="@string/hint_phone_number"
                style="@style/body_md_regular"
                android:textColorHint="@color/gray_400"
                android:paddingStart="48dp"
                android:paddingVertical="12dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_primary"
                android:inputType="number"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_62"
                android:layout_alignBaseline="@id/etPhone"
                android:layout_alignParentStart="true"
                android:layout_marginStart="15dp"
                style="@style/body_md_regular"
                android:textColor="@color/text_primary"/>
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnPickMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/rounded_green_border_button"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp"
        android:elevation="2dp"> <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/baseline_location_on_24"
        app:tint="@color/olive_500"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Titik Lokasi Tepat di Peta"
            android:textColor="@color/olive_500"
            style="@style/label_lg_bold"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etFullAddress"
        style="@style/body_lg_regular"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:autofillHints="name"
        android:background="@drawable/rounded_normal_edittext"
        android:gravity="top|start"
        android:hint="Detail alamat rumah anda"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/label_lg_bold"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Catatan untuk Kurir"
                android:textColor="@color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/label_md_bold"
                android:text=" (Opsional)"
                android:textColor="@color/black"
                android:textSize="12sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etNote"
            style="@style/body_lg_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="name"
            android:background="@drawable/rounded_normal_edittext"
            android:gravity="top|start"
            android:hint="Tolong titipkan di pos satpam depan"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/black" />
    </LinearLayout>


    <CheckBox
        android:id="@+id/cbMainAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jadikan Alamat Utama"
        android:buttonTint="@color/olive_500"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveAddress"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Simpan Alamat"
        android:textColor="@color/white"
        android:background="@drawable/rounded_success_button"
        style="@style/label_lg_bold"
        android:textAllCaps="false"/>

</LinearLayout>