<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sewa ID: ORD-XXX"
                android:textColor="@color/gray_500"
                style="@style/body_md_bold"/>
            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rounded_gray_layout"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Sewa Aktif"
                android:textColor="@color/main_color"
                style="@style/body_sm_bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPlant"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_gray_layout"
                android:clipToOutline="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Palem Kuning"
                    android:textColor="@color/black"
                    style="@style/body_lg_bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvBuyerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Budi Susanto"
                    android:textColor="@color/gray_900"
                    style="@style/body_md_regular"
                    android:layout_marginTop="2dp"
                    android:drawableStart="@drawable/user"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/gray_700"/>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Masa Sewa: 10 Aug - 10 Sep"
                    android:textColor="@color/gray_500"
                    style="@style/body_sm_regular"/>

                <TextView
                    android:id="@+id/tvNextMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Berikutnya: 15 Aug 2026"
                    android:textColor="@color/text_error"
                    style="@style/body_sm_bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:src="@drawable/location"
                app:tint="@color/main_color"/>
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Jl. Sudirman No 10, Surabaya"
                android:textColor="@color/main_color"
                style="@style/body_sm_regular"
                android:maxLines="2"
                android:ellipsize="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/right_arrow"
                app:tint="@color/main_color"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Chat Pembeli"
                style="@style/body_md_regular"
                android:textColor="@color/main_color"
                android:background="@drawable/rounded_green_border_button"
                android:layout_marginEnd="8dp"
                android:textAllCaps="false"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCompleteTask"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Kirim Bukti"
                style="@style/body_md_bold"
                android:textColor="@color/white"
                android:background="@drawable/rounded_success_button"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>