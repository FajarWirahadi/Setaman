<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_gray_layout">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kirim Bukti Perawatan"
        android:textSize="18sp"
        style="@style/title_lg_bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foto Bukti Tanaman *"
        style="@style/title_md_bold"
        android:textColor="@color/gray_900"
        android:layout_marginBottom="8dp"/>

    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/ic_camera_add"
        android:backgroundTint="@color/main_color"
        app:tint="@color/main_color"
        android:scaleType="fitCenter"
        android:clipToOutline="true"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Catatan Perawatan *"
        android:textColor="@color/gray_900"
        style="@style/title_md_bold" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:hint="Contoh: Sudah disiram dan diberi pupuk NPK..."
        android:padding="12dp"
        style="@style/body_md_regular"
        android:background="@drawable/rounded_gray_layout"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitLog"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Kirim Laporan"
        android:enabled="false"
        app:cornerRadius="8dp"
        android:background="@drawable/rounded_success_button"/>

</LinearLayout>