<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/rounded_white_button"
    android:padding="16dp"
    android:elevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_receipt"
                app:tint="@color/gray_700"/>

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORD-1234ABCD"
                android:textColor="@color/gray_900"
                style="@style/label_lg_bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menunggu"
            android:textSize="12sp"
            android:textColor="@color/olive_500"
            android:background="@drawable/rounded_green_border_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgOrderProduct"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_gray_layout"
            android:clipToOutline="true"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvOrderProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Bunga"
                android:textColor="@color/gray_900"
                style="@style/body_md_bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvOrderQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 barang"
                android:textColor="@color/gray_500"
                style="@style/label_lg_regular"
                android:layout_below="@id/tvOrderProductName"/>

            <TextView
                android:id="@+id/tvMoreItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 2 produk lainnya"
                android:textSize="12sp"
                android:textColor="@color/gray_700"
                android:layout_alignParentBottom="true"
                android:visibility="gone"/> </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginVertical="12dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Belanja"
                android:textColor="@color/gray_500"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvOrderGrandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 150.000"
                android:textColor="@color/gray_900"
                style="@style/title_md_bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnOrderAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Lihat Detail"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/rounded_success_button"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="16dp"
            android:textAllCaps="false"/>
    </RelativeLayout>
</LinearLayout>