<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingEnd="16dp"
    android:baselineAligned="false">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/viewLineTop"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:background="#E2E8F0" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFEBEE"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="#F44336"/>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/viewLineBottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anda"
                android:textColor="@color/black"
                style="@style/body_md_bold" />

            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pelanggan"
                android:textColor="@color/gray_500"
                android:layout_marginLeft="4dp"
                style="@style/body_sm_regular"
                android:visibility="visible"/>
        </LinearLayout>


        <TextView
            android:id="@+id/tvComplaintDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29 Mei 2026, 14:00"
            android:textColor="#9E9E9E"
            style="@style/body_sm_regular"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#F44336" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvComplaintReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alasan: Tanaman Layu"
                        android:textStyle="bold"
                        android:textColor="#F44336"
                        style="@style/body_md_bold"/>

                    <TextView
                        android:id="@+id/tvComplaintDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Deskripsi masalah..."
                        android:textColor="#424242"
                        style="@style/body_md_regular" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:id="@+id/imgComplaintEvidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:maxHeight="300dp"
                            android:scaleType="fitCenter"
                            android:background="#F5F5F5"
                            android:visibility="gone"/>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnQuoteComplaint"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|end"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/main_color"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:visibility="visible"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/viewConnector"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:background="#4CAF50"
            android:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSellerResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#C8E6C9"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F1F8E9"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#4CAF50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvResponseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggapan Penjual:"
                        android:textColor="#2E7D32"/>

                    <TextView
                        android:id="@+id/tvSellerResponseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Teks tanggapan penjual..."
                        android:textColor="#424242"
                        style="@style/body_md_regular"/>
                    <ImageView
                        android:id="@+id/imgSellerEvidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="300dp"
                        android:scaleType="fitCenter"
                        android:background="#F5F5F5"
                        android:visibility="gone"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnQuoteComplaint2"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|end"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="@color/main_color"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:visibility="visible"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>