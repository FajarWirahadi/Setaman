<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/rounded_white_button"
    android:padding="16dp"
    android:elevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- [ENTERPRISE FIX]: Tambahkan bg_status_badge agar Helper bisa mewarnainya menjadi kapsul -->
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status"
            style="@style/body_sm_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_badge"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/tvOrderStatus"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_receipt"
                app:tint="@color/gray_700"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORD-XXX"
                android:textColor="@color/gray_900"
                style="@style/label_md_bold"
                android:layout_marginRight="8dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginBottom="12dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/icUser"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/user"
            app:tint="@color/gray_500"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvBuyerName"
            style="@style/body_md_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/icUser"
            android:text="Nama Pembeli"
            android:textColor="@color/gray_700" />

        <TextView
            android:id="@+id/tvNewOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesanan Baru"
            android:textColor="@color/olive_500"
            style="@style/body_md_medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_accent_text"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgOrderProduct"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_gray_layout"
            android:clipToOutline="true"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvOrderProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Bunga"
                android:textColor="@color/gray_900"
                style="@style/body_md_bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Durasi : 1 bulan"
                android:textColor="@color/gray_500"
                style="@style/label_lg_regular"
                android:layout_below="@id/tvOrderProductName"/>

            <TextView
                android:id="@+id/tvDurationPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harga Perhari : Rp 2.500"
                android:textColor="@color/gray_500"
                style="@style/label_lg_regular"
                android:layout_below="@id/tvDuration"/>

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 75.000"
                android:textColor="@color/text_primary"
                style="@style/body_md_medium"
                android:layout_below="@id/tvDurationPrice"/>

            <TextView
                android:id="@+id/tvOrderQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x1"
                android:textColor="@color/text_primary"
                style="@style/body_md_medium"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginVertical="12dp"/>

    <LinearLayout
        android:id="@+id/layoutAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:src="@drawable/location"
            app:tint="@color/main_color"/>
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Memuat alamat..."
            android:textColor="@color/main_color"
            style="@style/body_sm_regular"
            android:maxLines="2"
            android:ellipsize="end"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/right_arrow"
            app:tint="@color/main_color"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 Produk"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_gravity="start"/>

        <LinearLayout
            android:id="@+id/layoutGrandTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pesanan:"
                android:textColor="@color/gray_500"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvOrderGrandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 150.000"
                android:textColor="@color/olive_500"
                style="@style/title_md_bold"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReject"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Tolak"
            android:textSize="12sp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/white"
            android:background="@drawable/rounded_error_button"
            android:layout_toStartOf="@id/btnOrderAction"
            android:layout_below="@id/layoutGrandTotal"
            android:paddingHorizontal="16dp"
            android:textAllCaps="false"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOrderAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Terima Pesanan"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/rounded_success_button"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/layoutGrandTotal"
            android:paddingHorizontal="16dp"
            android:textAllCaps="false"/>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginVertical="12dp"/>

    <LinearLayout
        android:id="@+id/layoutAccessTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_warning_text">

        <ImageView
            android:id="@+id/icAccessTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_access_time"
            app:tint="@color/text_warning"/>

        <TextView
            android:id="@+id/tvResponseDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batas Respon : Menghitung..."
            android:textColor="@color/text_warning"
            android:textSize="12sp"
            style="@style/body_sm_bold"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

</LinearLayout>