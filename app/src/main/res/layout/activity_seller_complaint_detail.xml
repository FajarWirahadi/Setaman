<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detail Sengketa"
            android:textColor="@color/black"
            style="@style/title_lg_bold"/>
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laporan Pembeli"
                android:textStyle="bold"
                android:textColor="@color/black"
                style="@style/label_lg_bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvComplaintReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alasan: Tanaman Layu/Mati"
                        android:textStyle="bold"
                        style="@style/label_lg_bold"
                        android:textColor="@color/text_error"/>

                    <TextView
                        android:id="@+id/tvComplaintDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Deskripsi masalah..."
                        style="@style/body_md_regular"/>

                    <ImageView
                        android:id="@+id/imgComplaintEvidence"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="centerCrop"
                        android:background="@color/gray_100" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggapan &amp; Resolusi Penjual"
                android:textColor="@color/black"
                style="@style/label_lg_bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSellerResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top|start"
                android:hint="Jelaskan tindakan yang akan Anda lakukan (misal: mengganti tanaman besok pagi)..."
                android:padding="12dp"
                android:background="@drawable/rounded_gray_layout"
                android:layout_marginBottom="24dp"
                style="@style/body_md_regular"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitResolution"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Kirim Resolusi &amp; Lanjutkan Perawatan"
                android:textColor="@color/white"
                android:backgroundTint="@color/olive_500"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>