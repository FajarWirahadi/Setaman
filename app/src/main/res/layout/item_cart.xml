<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/rounded_white_button"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/building"
            app:tint="@color/gray_700"/>

        <TextView
            android:id="@+id/tvCartShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Nama Toko"
            android:textColor="@color/gray_900"
            android:textSize="14sp"
            style="@style/label_lg_bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgCartProduct"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_gray_layout"
            android:clipToOutline="true"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvCartName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Bunga"
                android:textSize="14sp"
                android:textColor="@color/gray_900"
                style="@style/body_md_bold"
                android:layout_toStartOf="@id/btnDelete"
                android:maxLines="2"
                android:ellipsize="end"/>

            <LinearLayout
                android:id="@+id/btnEditDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/tvCartName"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_gray_layout"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvDurationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Mingguan"
                    android:textSize="12sp"
                    android:textColor="@color/gray_700"
                    style="@style/label_lg_regular"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/gray_700"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_trash_24"
                app:tint="@color/red_500" />

            <TextView
                android:id="@+id/tvCartPrice"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Rp 150.000"
                android:textColor="@color/olive_500"
                android:textSize="14sp"
                style="@style/label_lg_bold"
                android:layout_below="@id/btnEditDuration"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:padding="2dp"
                android:background="@drawable/item_cart_quantity">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    app:backgroundTint="@color/white"
                    android:background="@drawable/circle_background"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"/>

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:gravity="center"
                    android:textColor="@color/olive_500"
                    style="@style/label_lg_bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/circle_background"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/olive_500" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>