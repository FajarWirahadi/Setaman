<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/white">

    <ImageView
    android:id="@+id/imgNotifIcon"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:padding="8dp"
    android:background="@drawable/circle_background"
    android:backgroundTint="#E3F2FD"
    android:src="@drawable/ic_bell"
        android:layout_gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNotifTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan Dikirim!"
                style="@style/body_md_bold"
                android:textColor="@color/black"
                android:layout_toStartOf="@id/tvNotifDate"
                android:layout_alignParentStart="true"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvNotifDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="10:00"
                style="@style/body_sm_regular"
                android:textColor="@color/text_secondary" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvNotifBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Anggrek Bulan pesananmu sedang dalam perjalanan bersama kurir. Siapkan tempat terbaik untuknya!"
            style="@style/body_sm_regular"
            android:textColor="@color/gray_700" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgUnreadDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/circle_background"
        android:backgroundTint="#D32F2F" />
</LinearLayout>

