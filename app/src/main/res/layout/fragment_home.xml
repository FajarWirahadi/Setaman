<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="fitStart"
            android:src="@drawable/ic_logo_horizontal"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_envelope"
            android:layout_marginEnd="12dp"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            android:layout_marginEnd="12dp"
            android:scaleType="center"/>

        <RelativeLayout
            android:id="@+id/layoutCartBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnCart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cart" />

            <TextView
                android:id="@+id/tvCartBadgeCount"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/olive_500"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"
                android:visibility="gone"/>
        </RelativeLayout>

    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_gray_layout"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:hint="Cari Tanaman"
        android:paddingHorizontal="12dp"
        android:textSize="16sp"
        android:layout_below="@+id/headerLayout"/>

    <TextView
        android:id="@+id/tvPalingPopuler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paling Populer"
        style="@style/title_md_bold"
        android:textColor="@color/gray_900"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@id/etSearch"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBuyerProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvPalingPopuler"
            android:clipToPadding="false"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="20dp"
            android:scrollbars="horizontal"
            android:scrollbarThumbHorizontal="@color/olive_500"
            android:scrollbarSize="2dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabIndicatorColor="@color/olive_500"
        app:tabSelectedTextColor="@color/olive_500"
        app:tabTextColor="@color/gray_500"
        app:tabTextAppearance="@style/label_lg_bold"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        android:layout_below="@id/rvBuyerProducts"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svCategoryProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_below="@id/tabLayout">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            android:scrollbarSize="2dp"
            android:scrollbarThumbVertical="@color/olive_500" />
    </androidx.core.widget.NestedScrollView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:elevation="10dp"
                android:indeterminateTint="@color/olive_500"
                android:visibility="gone"/>

</RelativeLayout>