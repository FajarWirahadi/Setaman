<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_100"
    app:strokeWidth="1dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/logo_icon"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_photo"
                android:backgroundTint="@color/gray_100"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanaman kantor hias Palem Kuning"
                    style="@style/body_md_bold"
                    android:textColor="@color/gray_900"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 2.500 /hari"
                    style="@style/body_sm_bold"
                    android:textColor="@color/gray_900"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stok:"
                        style="@style/body_sm_bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:id="@+id/tvProductStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        style="@style/body_sm_bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:paddingVertical="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeactivate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Nonaktifkan"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:strokeWidth="5dp"
                android:background="@drawable/rounded_white_button"
                app:backgroundTint="@color/red_600"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:text="Ubah"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:paddingHorizontal="2dp"
                android:background="@drawable/rounded_white_button"
                app:backgroundTint="@color/olive_500"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ellipsis_vertical"
                android:background="@drawable/rounded_white_button"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>