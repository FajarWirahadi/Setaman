<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/gray_200"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/card_left_indicator"
            android:layout_width="4dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignBottom="@+id/bottom_anchor"
            android:background="@color/red_500" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_indicator"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@id/card_left_indicator"
            app:cardBackgroundColor="@color/red_50"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/red_200"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgBuyerProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvBuyerInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/red_600"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="P" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvComplaintStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/icon_indicator"
            android:layout_alignBottom="@id/icon_indicator"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            style="@style/body_sm_bold"
            android:textStyle="bold"
            tools:text="Menunggu Respon" />

        <TextView
            android:id="@+id/tvBuyerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/icon_indicator"
            android:layout_alignBottom="@id/icon_indicator"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/tvComplaintStatus"
            android:layout_toEndOf="@id/icon_indicator"
            android:gravity="center_vertical"
            android:textColor="@color/gray_800"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Robert Fox" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/icon_indicator"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@id/card_left_indicator"
            android:background="@color/gray_100" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imgPlantContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_below="@id/divider"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gray_200"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgPlant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gray_50"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPlantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/divider"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@id/imgPlantContainer"
            android:layout_toEndOf="@id/card_left_indicator"
            android:textColor="@color/gray_900"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Tanaman Mawar Merah" />

        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvPlantName"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@id/imgPlantContainer"
            android:layout_toEndOf="@id/card_left_indicator"
            android:textColor="@color/gray_500"
            android:textSize="13sp"
            tools:text="Sewa #RENTAL-123" />

        <TextView
            android:id="@+id/tvRentalDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOrderId"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@id/imgPlantContainer"
            android:layout_toEndOf="@id/card_left_indicator"
            android:textColor="@color/gray_500"
            android:textSize="13sp"
            tools:text="Masa Sewa: 12 Okt - 19 Okt" />

        <TextView
            android:id="@+id/tvReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvRentalDuration"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@id/imgPlantContainer"
            android:layout_toEndOf="@id/card_left_indicator"
            android:textColor="@color/red_600"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Kendala: Daun Layu" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvReason"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@id/imgPlantContainer"
            android:layout_toEndOf="@id/card_left_indicator"
            android:textColor="@color/gray_500"
            android:textSize="12sp"
            tools:text="Diajukan Pada: 12 Okt 2024" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRespond"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDate"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_toEndOf="@id/card_left_indicator"
            android:backgroundTint="@color/red_500"
            android:text="Tanggapi Komplain"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />

        <Space
            android:id="@+id/bottom_anchor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/btnRespond" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>